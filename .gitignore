# Secrets
.env

# TLS certs/keys
certs/

# Repacked agent binaries (embed the server's config and CA, never commit)
clients/
*.exe
*.msi

# Velociraptor log symlinks (broken on Windows filesystems, real logs are
# in the dated *.log.YYYYMMDDHHmm files)
velociraptor/*.log

# Stray file from a script writing to "nul" instead of /dev/null on Windows
velociraptor/nul
